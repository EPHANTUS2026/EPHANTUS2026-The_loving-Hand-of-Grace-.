# Public centre information
NEXT_PUBLIC_CENTRE_PHONE=+254721987024
NEXT_PUBLIC_CENTRE_EMAIL=info@thelovinghandofgrace.org
NEXT_PUBLIC_CENTRE_ADDRESS=Joska, opposite Hon. Makau's farm, Kenya
NEXT_PUBLIC_CENTRE_HOURS=Mon-Sat, 8:00 AM-5:00 PM
# Public click-to-WhatsApp number. Use E.164/international format; no sensitive data is embedded in links.
NEXT_PUBLIC_WHATSAPP_PUBLIC_NUMBER=+254721987024

# Supabase project. Keep service role server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Safaricom Daraja M-PESA. Use sandbox first.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback

# Secure scheduler secret for POST /api/graceflow/engine/tick
GRACEFLOW_ENGINE_SECRET=replace-with-long-random-secret

# GraceFlow Studio 2.0 connector adapters (server-side only)
GRACEFLOW_EMAIL_WEBHOOK_URL=
GRACEFLOW_EMAIL_WEBHOOK_TOKEN=
GRACEFLOW_SMS_WEBHOOK_URL=
GRACEFLOW_SMS_WEBHOOK_TOKEN=
GRACEFLOW_WHATSAPP_WEBHOOK_URL=
GRACEFLOW_WHATSAPP_WEBHOOK_TOKEN=

# Official WhatsApp Business Platform / Cloud API. Server-side only except public contact number above.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
WHATSAPP_TEMPLATE_BOOKING_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_BOOKING_RESCHEDULED=booking_rescheduled
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=booking_cancelled
WHATSAPP_TEMPLATE_CALLBACK_RECEIVED=callback_received

# Notification safety: disabled | staging | production. Staging requires an allowlist.
NOTIFICATIONS_MODE=disabled
NOTIFICATIONS_ALLOWLIST=

# Optional deployment metadata / operational controls
APP_ENV=development
LOG_LEVEL=info
# Call POST /api/graceflow/scheduler from a trusted cron service using GRACEFLOW_ENGINE_SECRET.

# Staging activation only. Never use real client data in staging.
STAGING_BASE_URL=https://your-staging-domain.example
STAGING_TEST_PASSWORD=
STAGING_TEST_EMAIL_DOMAIN=example.test
STAGING_TEST_EMAIL_PREFIX=lhg-stage
STAGING_PROVIDER_TOKEN=
# If using Vercel Cron, set CRON_SECRET. It may be the same long random value as GRACEFLOW_ENGINE_SECRET.
CRON_SECRET=
